---
import Base from '../layouts/Base.astro';

const work = [
  {
    icon: 'sync',
    title: 'Keep every order flowing',
    line: 'Orders, cancellations and returns from our two online stores and our retail stores reach the warehouse correctly.',
    more: 'Online and retail orders each run on their own integrations, along with catalog and inventory updates going back to the stores. I own all of them, and rebuilt the returns and exchanges process when the company switched returns providers.',
    tools: 'Shopify, JD Edwards, Oracle Integration Cloud',
  },
  {
    icon: 'tag',
    title: 'Keep product data consistent',
    line: 'Styles, pricing and seasons match between the design team’s system and the business system.',
    more: 'These syncs run in both directions and are among our most complex automations. Sales and product data are also copied into a reporting database, set up so a rerun never creates duplicates.',
    tools: 'Python, SQL, PolyPM, SQL Server, Oracle Autonomous Database',
  },
  {
    icon: 'plug',
    title: 'Connect the apps the business uses',
    line: 'Third-party apps that support different sides of the business stay in sync with our systems.',
    more: 'Wholesale orders from department-store partners are imported from order files into the business system. In-store traffic data lands in the reporting database. New-customer forms load straight into the business system. I also build custom syncs for very specific data other teams rely on.',
    tools: 'Python, REST APIs',
  },
  {
    icon: 'server',
    title: 'Run the automation platform',
    line: 'I manage the platform our scheduled jobs run on.',
    more: 'That covers who has access, where the code lives and shared pipeline templates. As part of a small team, I helped move 28 automations off an aging integration tool and rewrite them in Python.',
    tools: 'GitLab, GitLab CI, Linux',
  },
  {
    icon: 'eye',
    title: 'Watch every scheduled job',
    line: 'One app shows whether each job is turned on and when it last finished successfully.',
    more: 'Our jobs are scheduled across several systems, and GitLab only shows schedules one project at a time. I built a monitoring app that brings them all into one view.',
    tools: 'GitLab, Oracle Cloud Infrastructure',
  },
  {
    icon: 'app',
    title: 'Build new internal apps',
    line: 'I’m building an app to support the company’s move to vendor-made clothing.',
    more: 'It’s built in Oracle APEX, the modern option we’re adopting for new business tools.',
    tools: 'Oracle APEX, SQL',
  },
  {
    icon: 'people',
    title: 'Train the team',
    line: 'I’m the go-to person for our code and platform, and I write the training.',
    more: 'That includes primers and hands-on exercises for Oracle Integration Cloud, the one part of our stack where AI coding tools can’t help.',
    tools: 'Oracle Integration Cloud, AI-assisted coding',
  },
];

const icons: Record<string, string> = {
  sync: '<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>',
  tag: '<path d="M3.5 12.5V4.5a1 1 0 0 1 1-1h8l8 8-9 9z"/><circle cx="8.5" cy="8.5" r="1.5"/>',
  plug: '<path d="M9 3v5M15 3v5M6.5 8h11v3a5.5 5.5 0 0 1-11 0zM12 16.5V21"/>',
  server: '<rect x="4" y="4" width="16" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="16" height="6.5" rx="1.5"/><path d="M8 7.25h.01M8 16.75h.01"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>',
  app: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M3.5 9h17M8 13h8M8 16h5"/>',
  people: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9.5" r="2.4"/><path d="M15.5 14.6a4.6 4.6 0 0 1 5 4.9"/>',
};

const menu = [
  { group: 'Languages', items: 'Python, SQL' },
  { group: 'Databases', items: 'Oracle ATP & ADW, SQL Server, DuckDB' },
  { group: 'Integration', items: 'Oracle Integration Cloud, REST & GraphQL APIs' },
  { group: 'App building', items: 'Oracle APEX' },
  { group: 'Scheduling & CI', items: 'GitLab CI, Linux runners, Prefect' },
  { group: 'Transformation', items: 'SQL views, MERGE / upsert, dbt' },
  { group: 'Systems', items: 'Shopify, JD Edwards, PolyPM, third-party apps' },
  { group: 'Cloud & tooling', items: 'OCI Functions, Oracle Resource Scheduler, Git, AI coding tools' },
];

const timeline = [
  { when: 'Dec 2023 – now', what: 'Data Engineer', where: 'Koos Manufacturing (AG Jeans)' },
  { when: '2022', what: 'Web Developer', where: 'Crescendo Interactive' },
  { when: '2021', what: 'B.S. Computer Information Systems', where: 'Cal Poly Pomona' },
];
---
<Base
  title="Michelle Lee · Data Engineer"
  description="Michelle Lee is a data engineer in Los Angeles who builds and runs the pipelines between Shopify, JD Edwards and Oracle, and the CI platform they run on."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Michelle Lee</h1>
        <p class="hero-role">Data engineer in Los Angeles</p>
        <p class="hero-lede prose">
          I build the pipelines that move orders, returns and product data between Shopify,
          JD Edwards and Oracle at AG Jeans, and I run the CI platform those pipelines are scheduled on.
        </p>
        <div class="hero-actions">
          <a class="button" href="#projects">See my project</a>
          <a class="button button--ghost" href="mailto:hello@michulee.com">Email me</a>
        </div>
      </div>
      <figure class="portrait">
        <div class="arch">
          <img src="/img/portrait.jpg" alt="Illustrated portrait of Michelle" width="600" height="530" />
        </div>
        <figcaption>Portrait by DJARN</figcaption>
      </figure>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <h2>What I do at work</h2>
      <p class="prose muted">
        AG Jeans designs its clothing, makes some of it in-house and sources most from vendors,
        then sells online, in its own stores and wholesale. Here’s how its data connects, and the parts I build and run.
      </p>

      <div class="flow" role="img" aria-label="Two online stores and retail stores connect to the company’s business system through order integrations. The design system, third-party apps and a new vendor app connect to it through Python automations. Sales and product data are also copied to a reporting database. Everything runs on a scheduled platform Michelle manages.">
        <div class="flow-group">
          <p class="flow-title">Where we sell</p>
          <span class="chip">agjeans.com</span>
          <span class="chip">agjeansoutlet.com</span>
          <span class="chip">Retail stores</span>
        </div>
        <div class="flow-link"><span>Order integrations</span></div>
        <div class="flow-hub">
          <strong>Business system</strong>
          <span>the company’s ERP and source of truth</span>
        </div>
        <div class="flow-link"><span>Python automations</span></div>
        <div class="flow-group">
          <p class="flow-title">Where products and partner data live</p>
          <span class="chip">Design system (PolyPM)</span>
          <span class="chip">Third-party apps</span>
          <span class="chip chip--new">Vendor app, in progress</span>
        </div>
        <p class="flow-note">Sales and product data are also copied into a reporting database for the business to analyze.</p>
        <p class="flow-base">Every connection runs on a schedule, on the platform I manage, watched by a monitoring app I built.</p>
      </div>

      <div class="roles">
        {work.map((w) => (
          <details class="role">
            <summary>
              <span class="role-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[w.icon]} /></span>
              <span class="role-text"><strong>{w.title}</strong><span>{w.line}</span></span>
              <span class="role-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="role-more">
              <p>{w.more}</p>
              <p class="tools">{w.tools}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <h2>Outside work</h2>
      <p class="prose muted">
        A pipeline I’m building on my own time, held to the same standards as the ones I run at work.
      </p>

      <article class="project">
        <div class="project-head">
          <h3><a href="/budget-pipeline/">Budget Pipeline</a></h3>
          <span class="tag">In progress</span>
        </div>
        <p class="stack">Python · DuckDB · dbt · Prefect</p>
        <p class="prose">
          Shopping is my favorite hobby, and my most expensive one. My bank only shows an Amazon
          charge as a single total, so I’m building a pipeline that matches each charge to the items in
          the order emails. The goal is to see exactly where my money goes and set spending limits I’ll actually keep.
        </p>
        <ul class="status-list prose">
          <li><span class="tag tag--done">Done</span> Raw, staging and mart layers in DuckDB, built by dbt with 18 passing tests, run end to end by a Prefect flow and verified rerun-safe on synthetic data.</li>
          <li><span class="tag">Next</span> Connecting the live bank (SimpleFIN) and Gmail extractors, then scheduling it.</li>
        </ul>
        <a href="/budget-pipeline/">Read the case study</a>
      </article>
    </div>
  </section>

  <section id="menu" class="menu-section">
    <div class="wrap">
      <div class="menu-board">
        <h2>What I work with</h2>
        <dl class="menu">
          {menu.map((m) => (
            <div class="menu-row">
              <dt>{m.group}</dt>
              <dd>{m.items}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <h2>Experience</h2>
      <ol class="timeline">
        {timeline.map((t) => (
          <li>
            <span class="when">{t.when}</span>
            <span class="what">{t.what}</span>
            <span class="where">{t.where}</span>
          </li>
        ))}
      </ol>
      <p class="prose muted earlier">
        Before data work I built websites with React and JavaScript, which is where this site started in 2020.
      </p>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap">
      <h2>Let’s talk</h2>
      <p class="prose">
        I’m interested in data engineering roles focused on pipelines and the platforms they run on.
        Email is the fastest way to reach me.
      </p>
      <a class="button" href="mailto:hello@michulee.com">hello@michulee.com</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(1.5rem, 5vw, 4rem); border-top: 0; }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(3.4rem, 2rem + 7vw, 7.5rem);
    font-weight: 300;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .hero-role {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.7rem);
    color: var(--rose);
    margin: 1rem 0 1.5rem;
  }
  .hero-lede { font-size: 1.15rem; color: var(--foam); }
  .hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }

  /* an arched café window holding the portrait */
  .arch {
    margin: 0;
    background: var(--oat);
    border-radius: var(--radius-arch);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    box-shadow: 0 0 0 10px var(--walnut), 0 0 0 11px var(--brass);
    animation: glow-in 1.2s ease-out both;
  }
  .portrait { margin: 0; }
  .portrait figcaption { margin-top: 1.1rem; text-align: center; font-size: .8rem; color: var(--foam); }
  .arch img { width: 100%; height: 88%; object-fit: cover; object-position: center 70%; mix-blend-mode: multiply; }
  @keyframes glow-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .arch { animation: none; } }

  /* how the data connects */
  .flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem minmax(0, .8fr) 7.5rem minmax(0, 1fr);
    align-items: center;
    gap: .75rem 0;
    margin: 2.5rem 0 2.75rem;
  }
  .flow-group {
    background: var(--walnut);
    border: 1px solid var(--grain);
    border-radius: 18px;
    padding: 1.1rem 1.2rem 1.2rem;
    display: flex; flex-wrap: wrap; gap: .45rem;
    align-content: flex-start;
  }
  .flow-title { flex-basis: 100%; margin: 0 0 .35rem; font-family: var(--serif); font-size: 1.1rem; }
  .chip { font-size: .85rem; padding: .2rem .65rem; border-radius: 999px; background: var(--roast); color: var(--foam); border: 1px solid var(--grain); }
  .chip--new { border-style: dashed; border-color: var(--sage-deep); color: var(--sage); }
  .flow-hub {
    background: var(--rose); color: var(--roast);
    border-radius: 999px 999px 22px 22px;
    padding: 2rem 1rem 1.4rem;
    text-align: center; display: grid; gap: .2rem;
  }
  .flow-hub strong { font-family: var(--serif); font-weight: 500; font-size: 1.35rem; }
  .flow-hub span { font-size: .85rem; line-height: 1.3; }
  .flow-link { position: relative; height: 3rem; }
  .flow-link::before { content: ''; position: absolute; left: 10px; right: 10px; top: 50%; border-top: 1.5px solid var(--brass); }
  .flow-link::after {
    content: ''; position: absolute; inset: calc(50% - 5px) 0 auto 0; height: 10px;
    background:
      linear-gradient(135deg, transparent 50%, var(--brass) 50%) left / 10px 10px no-repeat,
      linear-gradient(-45deg, transparent 50%, var(--brass) 50%) right / 10px 10px no-repeat;
    clip-path: polygon(0 50%, 10px 0, 10px 100%, 0 50%, 100% 50%, calc(100% - 10px) 0, calc(100% - 10px) 100%);
  }
  .flow-link span { position: absolute; bottom: calc(50% + 6px); left: 0; right: 0; text-align: center; font-size: .78rem; line-height: 1.2; color: var(--brass); }
  .flow-note { grid-column: 1 / -1; margin: .5rem 0 0; text-align: center; color: var(--foam); font-size: .92rem; }
  .flow-base { grid-column: 1 / -1; margin: 0; border: 1px dashed var(--sage-deep); border-radius: 14px; padding: .75rem 1rem; text-align: center; color: var(--sage); font-size: .95rem; }

  /* the roles, one line each, details on tap */
  .roles { max-width: 56rem; border-top: 1px solid var(--grain); }
  .role { border-bottom: 1px solid var(--grain); }
  .role summary { list-style: none; display: grid; grid-template-columns: 2.75rem 1fr auto; gap: 1rem; align-items: center; padding: 1rem 0; cursor: pointer; }
  .role summary::-webkit-details-marker { display: none; }
  .role summary:hover .role-text strong { color: var(--rose); }
  .role-icon { width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--walnut); color: var(--rose); display: grid; place-items: center; }
  .role-icon svg { width: 1.3rem; height: 1.3rem; }
  .role-text { display: grid; gap: .15rem; }
  .role-text strong { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; transition: color .15s; }
  .role-text > span { color: var(--foam); }
  .role-toggle { font-size: 1.4rem; color: var(--brass); transition: transform .2s; padding: 0 .25rem; }
  .role[open] .role-toggle { transform: rotate(45deg); }
  .role-more { padding: 0 0 1.25rem 3.75rem; color: var(--foam); max-width: 66ch; }
  .role-more p { margin: 0 0 .4rem; }
  .role-more .tools { color: var(--sage); font-size: .92rem; margin: 0; }
  @media (prefers-reduced-motion: reduce) { .role-toggle, .role-text strong { transition: none; } }

  .project { padding: 2rem 0; }
  .project + .project { border-top: 1px dashed var(--grain); }
  .project-head { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; }
  .project-head a { color: var(--milk); text-decoration: none; }
  .project-head a:hover { color: var(--rose); }
  .stack { color: var(--sage); font-size: .95rem; margin: .5rem 0 1rem; }
  .project code { font-size: .9em; background: var(--walnut); padding: .05rem .35rem; border-radius: 4px; }
  .status-list { list-style: none; padding: 0; margin: 0 0 1.25rem; }
  .status-list li { display: grid; grid-template-columns: 4.2rem 1fr; gap: .75rem; align-items: baseline; margin: .6rem 0; color: var(--foam); }
  .status-list .tag { justify-self: start; }

  /* the café menu board: groups on the left, a brass dotted leader, the items on the right */
  .menu-board {
    background: var(--walnut);
    border-radius: 28px;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    border: 1px solid var(--grain);
  }
  .menu-board h2 { text-align: center; font-style: italic; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .menu { margin: 0 auto; max-width: 52rem; }
  .menu-row { display: flex; align-items: baseline; gap: .75rem; padding: .55rem 0; }
  .menu-row dt { font-family: var(--serif); font-size: 1.15rem; white-space: nowrap; }
  .menu-row dd {
    margin: 0;
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: .75rem;
    color: var(--foam);
    text-align: right;
  }
  .menu-row dd::before {
    content: '';
    flex: 1;
    min-width: 2rem;
    border-bottom: 2px dotted var(--brass);
    opacity: .55;
    transform: translateY(-0.3em);
  }

  .timeline { list-style: none; padding: 0; margin: 0; max-width: 46rem; }
  .timeline li {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    grid-template-areas: 'when what' 'when where';
    column-gap: 1.5rem;
    padding: 1rem 0 1rem 0;
    border-left: 1px solid var(--grain);
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px; top: 1.45rem;
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--rose);
  }
  .when { grid-area: when; color: var(--brass); padding-left: 1.25rem; font-size: .95rem; padding-top: .15rem; }
  .what { grid-area: what; font-family: var(--serif); font-size: 1.25rem; }
  .where { grid-area: where; color: var(--foam); }
  .earlier { margin-top: 1.75rem; }

  .contact h2 { font-size: clamp(2.2rem, 1.6rem + 2.5vw, 3.5rem); font-style: italic; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .contact .prose { color: var(--foam); margin-bottom: 1.75rem; }

  /* ---------- quiet café motifs, one per section, kept to the edges ---------- */
  #work, #projects { position: relative; isolation: isolate; overflow: hidden; }
  #work::before, #projects::before {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
  }
  /* a cup and saucer, bottom right */
  #work::before {
    background-image: url('/img/bg/cup.svg');
    width: 190px; height: 200px;
    right: max(1.5vw, calc(50% - 760px)); bottom: -36px;
    opacity: .08;
    transform: rotate(-6deg);
  }
  /* a pothos vine trailing from the top right */
  #projects::before {
    background-image: url('/img/bg/vine.svg');
    width: 300px; height: 390px;
    right: max(0px, calc(50% - 720px)); top: -10px;
    opacity: .12;
  }
  /* faint wood grain on the menu board */
  .menu-board { position: relative; isolation: isolate; overflow: hidden; }
  .menu-board::before {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: url('/img/bg/grain.svg') 0 0 / 520px auto repeat;
    opacity: .05;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    #work::before { display: none; }
    #projects::before { width: 160px; height: 210px; opacity: .09; }
  }

  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .portrait { max-width: 260px; order: -1; }
    .flow { grid-template-columns: 1fr; gap: 0; }
    .flow-link { height: 3.25rem; }
    .flow-link::before { left: 50%; right: auto; top: 8px; bottom: 8px; border-top: 0; border-left: 1.5px solid var(--brass); }
    .flow-link::after { display: none; }
    .flow-link span { bottom: auto; top: 50%; transform: translateY(-50%); left: calc(50% + .75rem); text-align: left; }
    .flow-hub { border-radius: 22px; padding: 1.25rem 1rem; }
    .flow-note { margin: 1rem 0 .75rem; }
    .role-more { padding-left: 0; }
    .menu-row { flex-wrap: wrap; gap: .1rem; }
    .menu-row dd { flex-basis: 100%; text-align: left; }
    .menu-row dd::before { display: none; }
    .timeline li { grid-template-columns: 1fr; grid-template-areas: 'when' 'what' 'where'; }
    .what, .where { padding-left: 1.25rem; }
  }
</style>
